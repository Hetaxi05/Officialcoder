FDC100" style="font-weight:600">150</span><span style="font-weight:600"> 창작 인센티브 포인트</span>를 추가로 받아 포인트 부족으로 창작 여정이 방해받지 않도록 하세요. 곧 MEME를 얻는 새로운 방법을 공개할 예정이니 계속 지원해 주세요.',goDiscordGetMeme:"DISCORD로 가서 포인트 받기",getYouReward:"MEME 포인트 창작 인센티브 받기",supportToDiscord:"지원팀에 문의",orderTipTitle:"미완료 주문이 있습니다",orderTipContent:"미결제 주문이 있습니다. 30분 후에 다시 결제를 시도해 주세요. 도움이 필요하면 Discord 채널에서 피드백을 제공해 주세요.",orderTipTitle2:"중복 거래 가능성",orderTipContent2:"중복 거래 주문이 있을 수 있습니다. 이 행동을 기록했습니다. 도움이 필요하면 Discord 채널에서 피드백을 제공해 주세요.",orderWaitDesc:"결제 페이지에서 결제를 완료해 주세요",payTip:"결제 팁",unsubscriptionPolicy:"구독 취소 정책",subscribeNow:"지금 구독하기",payWithStripe:"Stripe로 결제",upgradeToMemberNow:"지금 {plan} 회원으로 업그레이드",upgradeToMember:"{plan} 회원으로 업그레이드"}},aM=Object.freeze(Object.defineProperty({__proto__:null,default:oM},Symbol.toStringTag,{value:"Module"})),iM=Object.freeze(Object.defineProperty({__proto__:null,default:{time:{justNow:"방금",minutesAgo:"분 전",hoursAgo:"시간 전",daysAgo:"일 전",weeksAgo:"주 전",monthsAgo:"{num}개월 전",yearsAgo:"년 전",year:"년",month:"월",day:"일",hour:"시간",minute:"분",second:"초"}}},Symbol.toStringTag,{value:"Module"})),rM=Object.freeze(Object.defineProperty({__proto__:null,default:{user:{deleteVideoTitle:"이 비디오를 삭제하시겠습니까?",deleteVideoContent:"삭제 후에는 이 비디오를 복구할 수 없습니다. 작업을 확인해 주세요.",postVideoToCommunity:"커뮤니티에 비디오 게시",postComments:"댓글 게시",videoLikes:"비디오 좋아요",maximumDailyCommunityActivityReward:"일일 최대 커뮤니티 활동 보상:",commentIncentive:"댓글 인센티브",postLikeIncentive:"게시물 좋아요 인센티브",communityVideoIncentive:"커뮤니티 비디오 인센티브",browsingLevel:"탐색 수준",allowNsfwContentDisplay:"NSFW 콘텐츠 표시 허용",blurNsfwContentCovers:"NSFW 콘텐츠 커버 흐리게 처리",nsfwWarning:"이 비디오는 등급이",cancelTaskTitle:"현재 작업을 취소하시겠습니까?",cancelTaskContent:"취소하면 비디오 생성이 중단되고 새 작업이 대기열에 추가됩니다. 확인하시겠습니까?"}}},Symbol.toStringTag,{value:"Module"})),sM=Object.freeze(Object.defineProperty({__proto__:null,default:{common:{success:"Sukces",delete:"Usuń",cancel:"Anuluj",back:"Wstecz",show:"Pokaż",gotIt:"Rozumiem",confirm:"Potwierdź",continueGen:"Kontynuuj Gen",confirmA