-Easy-Number-Products1",sql:"CREATE TABLE Products (id INT PRIMARY KEY, name TEXT, price INT, quantity INT); INSERT INTO Products (id, name, price, quantity) VALUES (1, 'Keyboard', 250, 25), (2, 'Mouse', 175, 22), (7, 'Headphone', 150, 20), (5, 'HDMI Cable', 15, 28), (6, 'CPU', 350, 25);"},{createdAt:104,name:"Products",key:"CC-SQL-Very-Easy-Total-Products1",sql:"CREATE TABLE Products (id INT PRIMARY KEY, name TEXT, price INT, quantity INT); INSERT INTO Products (id, name, price, quantity) VALUES (1, 'Keyboard', 250, 25), (2, 'Mouse', 175, 22), (7, 'Headphone', 150, 20), (5, 'HDMI Cable', 15, 28), (6, 'CPU', 350, 25);"},{createdAt:105,name:"Numbers",key:"CC-SQL-Easy-Opposite-Numbers1",sql:"CREATE TABLE Numbers (id INT PRIMARY KEY, Value INT); INSERT INTO Numbers (id, Value) VALUES (1, -56), (2, 76), (3, -84), (4, 96), (5, -47);"},{createdAt:106,name:"Songs",key:"CC-SQL-Medium-Top-Charts1",sql:"CREATE TABLE Songs (id INT PRIMARY KEY, name TEXT, amount_sold INT); INSERT INTO Songs (id, name, amount_sold) VALUES (1, 'Please, Please, Please', 10000000), (2, 'Birds of a Feather', 2200000), (3, 'Slow it Down', 400000), (4, 'Houdini', 640000), (5, 'Million Dollar Baby', 450000), (6, 'Beautiful Things', 355000);"},{createdAt:107,name:"Age",key:"CC-SQL-Easy-Unique-Ages1",sql:"CREATE TABLE Age (id INT PRIMARY KEY, name TEXT, age INT); INSERT INTO Age (id, name, age) VALUES (1, 'Robert', 21), (2, 'Samantha', 19), (3, 'Ralph', 18), (4, 'Jimmy', 21), (5, 'Jon', 19), (6, 'Jessica', 20), (7, 'William', 21);"},{createdAt:108,name:"Countries",key:"CC-SQL-Easy-Big-Countries1",sql:"CREATE TABLE Countries (id INT PRIMARY KEY, name TEXT, continent TEXT, area INT, population INT, gdp INT); INSERT INTO Countries (id, name, continent, area, population, gdp) VALUES (1, 'Afghanistan', 'Asia', 652230, 25500100, 20343000000), (2, 'Albania', 'Europe', 28748, 2831741, 12960000000), (3, 'Algeria', 'Africa', 2381741, 37100000, 188681000000), (4, 'Andorra', 'Europe', 468, 78115, 3712000000), (5, 'Angola', 'Africa', 1246700, 20609294, 100990000000);"},{createdAt:109,name:"Parts",key:"CC-SQL-Easy-Unfinished-Parts1",sql:"CREATE TABLE Parts (part_id INT PRIMARY KEY, part_name TEXT, finished_date DATE); INSERT INTO Parts (part_id, part_name, finished_date ) VALUES (1001, 'motor', '2024-09-24'), (1012, 'battery', '2024-09-23'), (1023, 'motor',NULL), (1024, 'motor', '2024-09-27'), (1035, 'gear',NULL), (1044, 'battery', '2024-09-29'), (1047, 'gear', '2024-09-30');"},{createdAt:110,name:"Employees",key:"CC-SQL-Easy-Age-Group1",sql:"CREATE TABLE Employees (id INT PRIMARY KEY, name TEXT, age INT); INSERT INTO Employees (id, name, age) VALUES (1, 'Robert', 21), (2, 'Samantha', 19), (3, 'Ralph', 18), (4, 'Jimmy', 21), (5, 'Jon', 19), (6, 'Jessica', 20), (7, 'William', 21);"},{createdAt:111,name:"Numbers",key:"CC-SQL-Easy-All-Even1",sql:"CREATE TABLE Numbers (id INT PRIMARY KEY, value INT); INSERT INTO Numbers (id, value) VALUES (1, 56), (2, 77), (3, 84), (4, 96), (5, 47);"},{createdAt:112,name:"Teams",key:"CC-SQL-Easy-UCL-Qualification1",sql:"CREATE TABLE Teams (team TEXT PRIMARY KEY, goals INT, points INT); INSERT INTO Teams (team, goals, points) VALUES ('United', 90, 80), ('Chelsea', 45, 68), ('City', 80, 78), ('Spurs', 50, 50), ('Aston Villa', 42, 47), ('Arsenal', 53, 67), ('Liverpool', 54, 66);"},{createdAt:113,name:"Listings",key:"CC-SQL-Easy-Duplicate-Jobs1",sql:"CREATE TABLE Listings (job_id INT PRIMARY KEY, company_id INT, position TEXT); INSERT INTO Listings (job_id, company_id, position) VALUES (245, 1012, 'Data Analyst'), (250, 1122, 'Data Analyst'), (263, 1122, 'Business Analyst'), (277, 1219, 'QA'), (298, 1122, 'Business Analyst');"},{createdAt:114,name:"Courses",key:"CC-SQL-Easy-Power-Users1",sql:"CREATE TABLE Courses (user_id INT, course_completed TEXT); INSERT INTO Courses (user_id, course_completed) VALUES (1001, 'Learn Python Basics'), (1001, 'DSA with Python'), (1015, 'DSA with C++'), (1001, 'Learn SQL Basics'), (1032, 'Learn SQL Basics'), (1015, 'Learn HTML Basics'), (1047, 'DSA with Python'), (1069, 'DSA with C++');"},{createdAt:115,name:"Pages",key:"CC-SQL-Medium-No-Likes-1",sql:"CREATE TABLE Pages (page_id INT PRIMARY KEY, page_name TEXT, course_name TEXT); INSERT INTO Pages (page_id, page_name, course_name) VALUES (1001, 'Control Statement', 'Learn Python Basics'), (1007, 'Graph Data Structure ', 'DSA with C++'), (1015, 'Left Join', 'SQL Basics'), (1123, 'HTML Attributes', 'Learn HTML Basics'), (2122, 'Descendent Selector', 'Styling with CSS'), (1043, 'Top 4 Teams in the League', 'SQL Interview Questions');"},{createdAt:116,name:"Likes",key:"CC-SQL-Medium-No-Likes-2",sql:"CREATE TABLE Likes (user_id INT, page_id INT, liked_date DATE, PRIMARY KEY (user_id, page_id), FOREIGN KEY (page_id) REFERENCES Pages(page_id)); INSERT INTO Likes (user_id, page_id, liked_date) VALUES (110, 1001, '2024-09-21'), (121, 1015, '2024-09-24'), (321, 1043, '2024-09-26');"},{createdAt:117,name:"Viewership",key:"CC-SQL-Medium-Product-Viewership1",sql:"CREATE TABLE Viewership (user_id INT, course_name TEXT, device_type TEXT, view_time DATE); INSERT INTO Viewership (user_id, course_name, device_type, view_time) VALUES (1001, 'Learn Python Basics', 'Laptop', '2024-01-01'), (1007, 'DSA with C++', 'Phone', '2024-01-01'), (1001, 'SQL Basics', 'Laptop', '2024-01-02'), (1123, 'Learn HTML Basics', 'Tablet', '2024-01-03'), (1123, 'Styling with CSS', 'Tablet', '2024-01-03'), (1001, 'SQL Interview Questions', 'Phone', '2024-01-03');"},{createdAt:118,name:"Deals",key:"CC-SQL-Medium-Annual-Quota1",sql:"CREATE TABLE Deals (deal_id SERIAL PRIMARY KEY, employee_id INT, deal_size INT); INSERT INTO Deals (deal_id,employee_id, deal_size) VALUES (1,1001, 400000), (2,1001, 300000), (3,1015, 500000), (4,1022, 300000), (5,2012, 400000);"},{createdAt:119,name:"Quotas",key:"CC-SQL-Medium-Annual-Quota2",sql:"CREATE TABLE Quotas (employee_id INT PRIMARY KEY, quota INT); INSERT INTO Quotas (employee_id, quota) VALUES (1001, 500000), (1015, 400000), (1022, 400000