nt_holder TEXT, account_open_date DATE); INSERT INTO Accounts (account_id, account_holder, account_open_date) VALUES (1, 'John Doe', '2018-02-15'), (2, 'Jane Smith', '2019-07-23'), (3, 'Emily Davis', '2020-01-11');"},{createdAt:193,name:"Transactions",key:"CC-SQL-Expert-Fraudulent-Transaction2",sql:"PRAGMA foreign_keys = 1; CREATE TABLE Transactions (transaction_id INT PRIMARY KEY, account_id INT, transaction_date DATE, amount INT, FOREIGN KEY(account_id) REFERENCES Accounts(account_id)); INSERT INTO Transactions (transaction_id, account_id, transaction_date, amount) VALUES (1, 1, '2021-02-01', 200), (2, 1, '2021-06-15', 800), (3, 1, '2021-10-05', 350), (4, 2, '2021-03-22', 150), (5, 2, '2021-07-13', 100), (6, 2, '2021-12-15', 500), (7, 3, '2021-04-25', 400), (8, 3, '2021-06-20', 850), (9, 3, '2021-11-01', 900);"},{createdAt:194,name:"Products",key:"CC-SQL-Expert-Monthly-Growth1",sql:"PRAGMA foreign_keys = 1; CREATE TABLE Products (product_id INT PRIMARY KEY, product_name TEXT, category TEXT); INSERT INTO Products (product_id, product_name, category) VALUES (1, 'Product A', 'Electronics'), (2, 'Product B', 'Clothing'), (3, 'Product C', 'Home Goods');"},{createdAt:195,name:"Sales",key:"CC-SQL-Expert-Monthly-Growth2",sql:"PRAGMA foreign_keys = 1; CREATE TABLE Sales (sale_id INT PRIMARY KEY, product_id INT, sale_date DATE, revenue INT, FOREIGN KEY(product_id) REFERENCES Products(product_id)); INSERT INTO Sales (sale_id, product_id, sale_date, revenue) VALUES (1, 1, '2023-01-10', 500), (2, 1, '2023-02-15', 700), (3, 2, '2023-01-20', 300), (4, 2, '2023-02-18', 600), (5, 3, '2023-01-25', 400), (6, 3, '2023-02-27', 300);"},{createdAt:196,name:"Animal_Sightings",key:"CC-SQL-Medium-Animal-Sightings1",sql:"CREATE TABLE Animal_Sightings (sighting_id INT PRIMARY KEY, animal_name TEXT, park_name TEXT); INSERT INTO Animal_Sightings (sighting_id, animal_name, park_name) VALUES (1, 'Deer', 'Yellowstone'), (2, 'Bear', 'Yellowstone'), (3, 'Deer', 'Yellowstone'), (4, 'Fox', 'Grand Can