, 'The Picture of Dorian Gray', 'Oscar Wilde'), (5, 'Great Expectations', 'Charles Dickens');"},{createdAt:202,name:"Products",key:"CC-SQL-Medium-Recent-Prices1",sql:"CREATE TABLE Products (product_id INT PRIMARY KEY, category TEXT, price INT, updated_at DATE); INSERT INTO Products (product_id, category, price, updated_at) VALUES (1, 'Electronics', 500, '2023-10-01'), (2, 'Furniture', 1200, '2023-10-05'), (3, 'Electronics', 520, '2023-11-01'), (4, 'Furniture', 1100, '2023-08-20'), (5, 'Kitchen', 150, '2023-11-15');"},{createdAt:203,name:"Prices",key:"CC-SQL-Medium-Adjacent-Prices1",sql:"CREATE TABLE Prices (price_id INT PRIMARY KEY, price_date DATE, price INT); INSERT INTO Prices (price_id, price_date, price) VALUES (1, '2023-10-01', 105), (2, '2023-10-02', 105), (3, '2023-10-03', 106), (4, '2023-10-04', 106), (5, '2023-10-05', 108), (6, '2023-10-06', 108), (7, '2023-10-07', 107);"},{createdAt:204,name:"Employees",key:"CC-SQL-Medium-Non-Standard-Job1",sql:"CREATE TABLE Employees (emp_id INT PRIMARY KEY, emp_name TEXT, job_title TEXT); INSERT INTO Employees (emp_id, emp_name, job_title) VALUES (1, 'Alice', 'Engineer'), (2, 'Bob', 'Sales'), (3, 'Carol', 'Product Manager'), (4, 'David', 'Designer'), (5, 'Eve', 'Engineer'), (6, 'Frank', 'HR Specialist');"},{createdAt:205,name:"Products",key:"CC-SQL-Medium-No-Vowel-Product-Name1",sql:"CREATE TABLE Products (product_id INT PRIMARY KEY, product_name TEXT); INSERT INTO Products (product_id, product_name) VALUES (1, 'Chalk'), (2, 'Pen'), (3, 'Ruler'), (4, 'Glue'), (5, 'Pstck'), (6, 'Crdbrd');"},{createdAt:206,name:"Books",key:"CC-SQL-Very-Easy-Delete-Book1",sql:"CREATE TABLE Books (id INT PRIMARY KEY, title TEXT); INSERT INTO Books (id, title) VALUES (1, 'The Great Gatsby'), (2, 'To Kill a Mockingbird'), (3, 1984);"},{createdAt:207,name:"Products",key:"CC-SQL-Easy-Change-Name1",sql:"CREATE TABLE Products (product_id INT PRIMARY KEY, product_name TEXT, price INT); INSERT INTO Products (product_id, product_name, price) VALUES 